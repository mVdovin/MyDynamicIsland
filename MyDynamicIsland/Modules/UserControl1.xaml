<UserControl x:Class="MyDynamicIsland.Modules.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyDynamicIsland"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Универсальный переключатель -->
        <ControlTemplate x:Key="FluentToggleSwitchTemplate" TargetType="CheckBox">
            <Grid Cursor="Hand" VerticalAlignment="Center">
                <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#33808080" BorderBrush="#44808080" BorderThickness="1">
                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#CCCCCC" HorizontalAlignment="Left" Margin="2,0,0,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                    <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Thumb" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FluentToggleStyle" TargetType="CheckBox">
            <Setter Property="Template" Value="{DynamicResource FluentToggleSwitchTemplate}"/>
        </Style>

        <!-- Стиль полосы прокрутки -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Rectangle" CornerRadius="6" Background="{DynamicResource CardBorder}" Margin="4,4,2,4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rectangle" Property="Opacity" Value="0.8" />
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding VerticalScrollBarVisibility}"
                                   Width="8">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid x:Name="TrackGrid" Background="{DynamicResource SBackground}">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Основной стек модуля -->
    <StackPanel Margin="0,8,0,0">
        
        <!-- КЛИКАБЕЛЬНАЯ ШАПКА (Спойлер): Background="Transparent" обязателен для отлова кликов -->
        <Border x:Name="HeaderCard"
                CornerRadius="12"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Cursor="Hand">
            <DockPanel Margin="18,10,18,10" VerticalAlignment="Center">
                <TextBlock Text="Тут будуть додаватись нові модулі"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Переключатель вкл/выкл мониторинга -->
                <CheckBox x:Name="MainMonitoringToggle"
                          Style="{DynamicResource FluentToggleStyle}"
                          IsChecked="False"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        
    </StackPanel>
</UserControl>
