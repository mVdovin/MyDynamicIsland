<UserControl x:Class="MyDynamicIsland.SystemMonitoringModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyDynamicIsland"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Универсальный переключатель -->
        <ControlTemplate x:Key="FluentToggleSwitchTemplate" TargetType="CheckBox">
            <Grid Cursor="Hand" VerticalAlignment="Center">
                <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#33808080" BorderBrush="#44808080" BorderThickness="1">
                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#CCCCCC" HorizontalAlignment="Left" Margin="2,0,0,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                    <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Thumb" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FluentToggleStyle" TargetType="CheckBox">
            <Setter Property="Template" Value="{DynamicResource FluentToggleSwitchTemplate}"/>
        </Style>

        <!-- Стиль полосы прокрутки -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Rectangle" CornerRadius="6" Background="{DynamicResource CardBorder}" Margin="4,4,2,4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rectangle" Property="Opacity" Value="0.8" />
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollStyle" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding VerticalScrollBarVisibility}"
                                       Width="8">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid x:Name="TrackGrid" Background="{DynamicResource SBackground}">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Основной стек модуля -->
    <StackPanel>

        <!-- КЛИКАБЕЛЬНАЯ ШАПКА (Спойлер): Background="Transparent" обязателен для отлова кликов -->
        <Border x:Name="HeaderCard"
                CornerRadius="12"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Background="Transparent"
                Cursor="Hand"
                MouseLeftButtonDown="HeaderCard_MouseLeftButtonDown">
            <DockPanel Margin="18,10,18,10" VerticalAlignment="Center">
                <StackPanel Orientation ="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Моніторинг системи"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Переключатель вкл/выкл мониторинга -->
                        <CheckBox x:Name="MainMonitoringToggle"
                                  Style="{DynamicResource FluentToggleStyle}"
                                  IsChecked="False"
                                  Checked="MainMonitoringToggle_Checked"
                                  Unchecked="MainMonitoringToggle_Unchecked"
                                  VerticalAlignment="Center"
                                  Margin="129,0,0,0"/>
                    </StackPanel>


                    <!-- Информационная подсказка о правах администратора -->
                    <TextBlock x:Name="AdminWarningText" 
                           Text="⚠️ Деякі показники можуть бути недоступні (потрібен запуск від адміністратора)" 
                           FontSize="8" 
                           Foreground="#A0A0A0" 
                           TextWrapping="Wrap" 
                           Margin="0,4,0,0" 
                           Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- БЛОК НАСТРОЕК: по умолчанию скрыт (Visibility="Collapsed") -->
        <Border x:Name="SettingsContainer"
                Visibility="Collapsed"
                CornerRadius="12" 
                BorderBrush="{DynamicResource CardBorder}" 
                BorderThickness="1"
                Margin="0,8,0,0"
                Padding="0"
                ClipToBounds="True">

            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="#1A1A1A" Width="{Binding ActualWidth, ElementName=SettingsContainer}" Height="{Binding ActualHeight, ElementName=SettingsContainer}" CornerRadius="12" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Height="230"
                          Background="Transparent"
                          local:ScrollHelper.EnableSmoothScroll="True"
                          Style="{DynamicResource ModernScrollStyle}">

                <StackPanel Orientation="Vertical" Margin="4,4,0,4">

                    <!-- 1. Процессор (CPU) - только загрузка и частота -->
                    <Border BorderBrush="{DynamicResource CardBorder}" 
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,0"
                            Background="{DynamicResource CardBackground}" 
                            IsEnabled="{Binding IsChecked, ElementName=MainMonitoringToggle}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="246">
                                <TextBlock Text="Процесор (CPU)"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,0"/>
                                <TextBlock x:Name="CpuText"
                                           Text="CPU: ініціалізація..."
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"/>
                            </StackPanel>

                            <CheckBox x:Name="CpuToggle"
                                      Style="{DynamicResource FluentToggleStyle}"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Видеокарта (GPU) -->
                    <Border BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,6,0,0"
                            Background="{DynamicResource CardBackground}"
                            IsEnabled="{Binding IsChecked, ElementName=MainMonitoringToggle}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="246">
                                <TextBlock Text="Відеокарта (GPU)"
                                           Foreground="{DynamicResource TextPrimary}" 
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,0"/>
                                <TextBlock x:Name="GpuText"
                                           Text="GPU: ініціалізація..."
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"/>
                            </StackPanel>

                            <CheckBox x:Name="GpuToggle"
                                      Style="{DynamicResource FluentToggleStyle}"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Оперативная память (RAM) -->
                    <Border BorderBrush="{DynamicResource CardBorder}" 
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,6,0,0"
                            Background="{DynamicResource CardBackground}" 
                            IsEnabled="{Binding IsChecked, ElementName=MainMonitoringToggle}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="246">
                                <TextBlock Text="Оперативна пам'ять (RAM)"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,0"/>
                                <TextBlock x:Name="RamText"
                                           Text="RAM: ініціалізація..."
                                           Foreground="{DynamicResource TextSecondary}" 
                                           FontSize="11"/>
                            </StackPanel>

                            <CheckBox x:Name="RamToggle"
                                      Style="{DynamicResource FluentToggleStyle}"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Накопители (Диски) -->
                    <Border BorderBrush="{DynamicResource CardBorder}" 
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,6,0,0"
                            Background="{DynamicResource CardBackground}"
                            IsEnabled="{Binding IsChecked, ElementName=MainMonitoringToggle}">
                        <StackPanel>
                            <TextBlock Text="Накопичувачі (Диски)"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,0"/>

                            <ItemsControl x:Name="DisksItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <CheckBox DockPanel.Dock="Right"
                                                      Style="{DynamicResource FluentToggleStyle}"
                                                      IsChecked="{Binding IsSelectedForCompact, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,10,0"/>

                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="12"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text="{Binding DisplayDetails}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 5. Сетевые адаптеры (Мережа) -->
                    <Border BorderBrush="{DynamicResource CardBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14,10"
                            Margin="0,6,0,0"
                            Background="{DynamicResource CardBackground}" 
                            IsEnabled="{Binding IsChecked, ElementName=MainMonitoringToggle}">
                        <StackPanel>
                            <TextBlock Text="Мережа (Network)" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"/>

                            <ItemsControl x:Name="NetworksItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <CheckBox DockPanel.Dock="Right"
                                                      Style="{DynamicResource FluentToggleStyle}"
                                                      IsChecked="{Binding IsSelectedForCompact, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,10,0"/>

                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                           Foreground="{DynamicResource TextPrimary}" 
                                                           FontSize="12" 
                                                           FontWeight="Medium"/>
                                                <TextBlock Text="{Binding DisplayDetails}" 
                                                           Foreground="{DynamicResource TextSecondary}" 
                                                           FontSize="11" 
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </StackPanel>

</UserControl>